                      "  pm.expect(strataResult.conflictingClaims).to.eql([['APPROVE', 'REJECT'], ['REJECT', 'approve']]);",
                      "});",
                      "pm.test('Matches default response', () => pm.expect(strataResult).to.eql(JSON.parse(pm.collectionVariables.get('m4Baseline'))));"
                    ]
