{
  "info": {
    "name": "Strata M3 - Submit Evidence",
    "description": "AI-assisted M3 API tests. Run the whole collection in order against the test-only fixture launcher; see README. No production fixture endpoints are added.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "analysisId",
      "value": "m3-open"
    },
    {
      "key": "readyAnalysisId",
      "value": "m3-ready"
    },
    {
      "key": "finalizedAnalysisId",
      "value": "m3-finalized"
    }
  ],
  "item": [
    {
      "name": "Op2 Submit Evidence",
      "item": [
        {
          "name": "Accept evidence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/analyses/{{analysisId}}/evidence",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{runId}}-submit\",\n  \"sourceId\": \"{{runId}}-source\",\n  \"claim\": \"  Accept   the change  \",\n  \"confidenceScore\": 0.8,\n  \"evidenceType\": \" review \",\n  \"metadata\": {\n    \"url\": \"https://example.com/review\",\n    \"checks\": [\n      \"security\",\n      \"performance\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.unset(\"receipt\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const receipt = pm.response.json();",
                  "pm.test(\"Receipt fields\", () => {",
                  "  pm.expect(receipt.evidenceId).to.be.a(\"string\");",
                  "  pm.expect(receipt.normalizedConfidenceScore).to.eql(0.8);",
                  "  pm.expect(receipt.acceptanceStatus).to.eql(\"ACCEPTED\");",
                  "  pm.expect(Number.isNaN(Date.parse(receipt.submittedAt))).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set(\"receipt\", JSON.stringify(receipt));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry returns original receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/analyses/{{analysisId}}/evidence",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{runId}}-submit\",\n  \"sourceId\": \"{{runId}}-source\",\n  \"claim\": \"  Accept   the change  \",\n  \"confidenceScore\": 0.8,\n  \"evidenceType\": \" review \",\n  \"metadata\": {\n    \"url\": \"https://example.com/review\",\n    \"checks\": [\n      \"security\",\n      \"performance\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Original receipt is unchanged\", () => pm.expect(pm.response.json()).to.deep.eql(",
                  "  JSON.parse(pm.collectionVariables.get(\"receipt\"))));"
                ]
              }
            }
          ]
        },
